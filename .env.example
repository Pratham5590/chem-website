# Runtime connection used by Vercel app (Neon pooled URL, hostname includes -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# One-time migration only. Use Neon's DIRECT (non-pooler) connection string here.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Existing MySQL source database. Keep these values local; do not commit .env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=chemistry_website

NODE_ENV=development
PORT=3000
